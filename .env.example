# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_doc_db
POSTGRES_PORT=5432

# Database URL used by the application
# For Docker Compose (service name 'db'):
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/ai_doc_db
# For local development outside Docker:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/ai_doc_db
