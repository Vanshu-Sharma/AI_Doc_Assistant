# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_doc_db
POSTGRES_PORT=5432

# Database URL used by the application
# For Docker Compose (service name 'db'):
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/ai_doc_db
# For local development outside Docker (host port mapping default is 5435 or 5432):
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5435/ai_doc_db

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-safeguard-20b

# Optional: Custom model pricing overrides (USD per 1M tokens)
# GEMINI_INPUT_PRICE_PER_MILLION=0.50
# GEMINI_OUTPUT_PRICE_PER_MILLION=3.00
# GROQ_INPUT_PRICE_PER_MILLION=0.075
# GROQ_OUTPUT_PRICE_PER_MILLION=0.30

# File Upload & Ingestion Configuration
UPLOAD_DIR=uploads
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# to stream over terminal:
# curl.exe -N -X POST "http://127.0.0.1:8000/ask" -H "Content-Type: application/json" --data-binary "@request.json"